{
  "name": "biblemates",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "mobile": "pnpm --filter @biblemates/mobile start",
    "ios": "pnpm --filter @biblemates/mobile ios",
    "android": "pnpm --filter @biblemates/mobile android",
    "web": "pnpm --filter @biblemates/mobile web",
    "verify": "node scripts/verify.mjs",
    "typecheck": "node scripts/verify.mjs typecheck",
    "lint": "node scripts/verify.mjs lint",
    "style": "node scripts/check-style.mjs",
    "contrast": "tsx scripts/check-contrast.ts",
    "test": "node scripts/verify.mjs test",
    "screenshots": "node scripts/verify.mjs screenshots",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
