{
  "expo": {
    "name": "Biblemates",
    "slug": "biblemates",
    "scheme": "biblemates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "YTL4NC2WW9",
      "bundleIdentifier": "com.gabeinf.Biblemates",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7C341",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gabeinf.biblemates"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#243E69"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B68335"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Biblemates uses your photos so you can add a profile picture for your circle.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d2b5c77-ebcf-464e-bfd3-6873c596f9e4"
      }
    },
    "owner": "gabeinf"
  }
}
