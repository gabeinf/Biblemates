# apps/server/.env — server-only secrets. Never prefix these with EXPO_PUBLIC_.
# Copy to .env and fill in.

# Supabase: Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>

# Embeddings (OpenAI text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=<openai key>

# Translation that gets embedded, searched and quoted (bible-api.com id)
SCRIPTURE_TRANSLATION=asv

# Chat answers (used from step 2)
ANTHROPIC_API_KEY=<anthropic key>
CLAUDE_MODEL=claude-haiku-5-5

# Drizzle typed queries (db:pull + chat history). Session pooler, IPv4:
# Supabase -> Connect -> Session pooler. Password: Project Settings -> Database.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

PORT=3000
